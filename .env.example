# Neon, free plan. Create the project in an EU region so it sits next to the
# Vercel functions, which vercel.json pins to dub1.
DATABASE_URL=

# The moderation queue at /admin?k=... . Any long random string:
#   openssl rand -base64 24
ADMIN_PASSWORD=

# Optional. A backstop against a runaway script, not a limit on a person —
# there is no per-visitor cap. Defaults to 2000/day.
DAILY_GENERATION_CEILING=2000

# Vercel Blob, for the optional screenshot on a burial. Create the store in the
# Vercel dashboard and it sets this for you. WITHOUT IT the screenshot field is
# hidden rather than shown-and-broken — check /bury after wiring it.
BLOB_READ_WRITE_TOKEN=
